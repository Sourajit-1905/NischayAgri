{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "advice_response.schema.json",
  "title": "AdviceResponse",
  "type": "object",
  "required": ["mode", "summary", "sections", "citations", "safety_notice"],
  "properties": {
    "mode": { "$ref": "common.schema.json#/$defs/AdviceMode" },
    "summary": { "type": "string" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "source"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "source": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "snippet": { "type": "string" }
        }
      }
    },
    "safety_notice": { "type": "string" }
  }
}