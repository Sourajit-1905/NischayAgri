{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "predict_response.schema.json",
  "title": "PredictionResponse",
  "type": "object",
  "required": [
    "request_id",
    "model_version",
    "crop",
    "disease",
    "severity",
    "uncertainty",
    "ood",
    "decision",
    "image_quality"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "model_version": {
      "type": "string"
    },
    "crop": {
      "type": "object",
      "required": [
        "label",
        "confidence"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "disease": {
      "type": "object",
      "required": [
        "label",
        "confidence",
        "top_k"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top_k": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "confidence"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "severity": {
      "type": "object",
      "required": [
        "level",
        "confidence"
      ],
      "properties": {
        "level": {
          "$ref": "common.schema.json#/$defs/SeverityLevel"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "calibrated_confidence",
        "entropy",
        "method"
      ],
      "properties": {
        "calibrated_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "entropy": {
          "type": "number",
          "minimum": 0
        },
        "method": {
          "type": "string",
          "description": "e.g. temperature_scaling, mc_dropout, deep_ensemble, conformal"
        }
      }
    },
    "ood": {
      "type": "object",
      "required": [
        "score",
        "is_ood"
      ],
      "properties": {
        "score": {
          "type": "number"
        },
        "is_ood": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "action",
        "reason"
      ],
      "properties": {
        "action": {
          "$ref": "common.schema.json#/$defs/Decision"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "image_quality": {
      "type": "object",
      "required": [
        "blur",
        "lighting",
        "framing",
        "usable"
      ],
      "properties": {
        "blur": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lighting": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "framing": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "usable": {
          "type": "boolean"
        }
      }
    },
    "explanation": {
      "type": "object",
      "properties": {
        "heatmap_png_base64": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}